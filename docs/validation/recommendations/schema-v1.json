{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/eda-hub/horse-man/blob/feature/next-cycle-prediction-contract/docs/validation/recommendations/schema-v1.json",
  "title": "次期オッズ非依存推奨買い目snapshot契約",
  "description": "正式適用は第3検証サイクル終了審査とStage 2の発効日固定後。券種別頭数・時点・照合・依存監査はscripts/recommendation.pyで追加検証する。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "recommendation_contract",
    "recommendation_id",
    "race_id",
    "race_date_jst",
    "manual_release",
    "manual_ref_commit",
    "working_branch",
    "scheduled_post_time_jst",
    "data_cutoff",
    "fixed_at_jst",
    "prediction_ref",
    "revision",
    "supersedes",
    "phase",
    "status",
    "reason",
    "cancelled_horses",
    "main_ticket_types",
    "tickets",
    "unique_ticket_count",
    "horse_roles",
    "scenarios",
    "candidate_decisions",
    "dependency_audit"
  ],
  "properties": {
    "schema_version": {
      "const": "recommendation-snapshot-v1"
    },
    "recommendation_contract": {
      "const": "odds-free-recommendation-v1"
    },
    "recommendation_id": {
      "type": "string",
      "minLength": 1
    },
    "race_id": {
      "type": "string",
      "minLength": 1
    },
    "race_date_jst": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "manual_release": {
      "const": "v1.7.0"
    },
    "manual_ref_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "working_branch": {
      "type": "string",
      "minLength": 1
    },
    "scheduled_post_time_jst": {
      "type": "string",
      "format": "date-time"
    },
    "data_cutoff": {
      "type": "string",
      "format": "date-time"
    },
    "fixed_at_jst": {
      "type": "string",
      "format": "date-time"
    },
    "prediction_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_path",
        "artifact_id",
        "sha256",
        "baseline_forecast_id"
      ],
      "properties": {
        "artifact_path": {
          "type": "string"
        },
        "artifact_id": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "baseline_forecast_id": {
          "type": "string"
        }
      }
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ]
    },
    "supersedes_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "phase": {
      "enum": [
        "FINAL",
        "INITIAL_PROVISIONAL"
      ]
    },
    "status": {
      "enum": [
        "RECOMMENDED",
        "NO_RECOMMENDATION",
        "EXPLICIT_MARKS_ONLY",
        "PENDING"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "cancelled_horses": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      },
      "uniqueItems": true
    },
    "main_ticket_types": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/betType"
      },
      "uniqueItems": true
    },
    "tickets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "horses",
          "priority",
          "scenario_id",
          "reason"
        ],
        "properties": {
          "type": {
            "$ref": "#/$defs/betType"
          },
          "horses": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "priority": {
            "type": "integer",
            "minimum": 1
          },
          "scenario_id": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "unique_ticket_count": {
      "type": "integer",
      "minimum": 0
    },
    "horse_roles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "horse_no",
          "finish_role",
          "reason",
          "source_ref",
          "scenario_id",
          "observed_at_jst"
        ],
        "properties": {
          "horse_no": {
            "type": "integer",
            "minimum": 1
          },
          "finish_role": {
            "enum": [
              "WIN",
              "TOP2",
              "TOP3"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "source_ref": {
            "type": "string",
            "minLength": 1
          },
          "scenario_id": {
            "type": "string",
            "minLength": 1
          },
          "observed_at_jst": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scenario_id",
          "description",
          "probability_status"
        ],
        "properties": {
          "scenario_id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "probability_status": {
            "enum": [
              "NOT_CALCULATED",
              "CALCULATED"
            ]
          },
          "probability_range": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "minItems": 2,
            "maxItems": 2
          },
          "probability_method": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "candidate_decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "status",
          "reason"
        ],
        "properties": {
          "type": {
            "$ref": "#/$defs/betType"
          },
          "status": {
            "enum": [
              "SELECTED",
              "REJECTED"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "dependency_audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "anchor_dependency",
        "scenario_overlap_reason"
      ],
      "properties": {
        "anchor_dependency": {
          "enum": [
            "ALL",
            "PARTIAL",
            "NONE"
          ]
        },
        "scenario_overlap_reason": {
          "type": "string",
          "minLength": 1
        },
        "lower_bound_review": {
          "type": "string"
        },
        "anchor_failure_scenario": {
          "type": "string"
        }
      }
    }
  },
  "$defs": {
    "betType": {
      "enum": [
        "WIN",
        "PLACE",
        "QUINELLA",
        "WIDE",
        "EXACTA",
        "TRIO",
        "TRIFECTA"
      ]
    }
  }
}
