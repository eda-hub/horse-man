{
  "name": "Horse Codex",
  "dockerComposeFile": "docker-compose.yml",
  "service": "codex",
  "workspaceFolder": "/workspace",
  "remoteUser": "node",
  "shutdownAction": "stopCompose",
  "remoteEnv": {
    "PATH": "/home/node/.local/bin:${containerEnv:PATH}"
  },
  "postCreateCommand": "mkdir -p /home/node/.local && npm install --global --prefix /home/node/.local --include=optional @openai/codex@0.150.1 && /home/node/.local/bin/codex --version",
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}
